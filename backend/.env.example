# SalingJaga Backend Configuration

# Server Port
PORT=3001

# AI Configuration (Mode: 'demo' or 'langflow')
# Ganti ke 'langflow' untuk mengaktifkan integrasi Langflow
AI_MODE=demo

# Langflow Configuration (Required if AI_MODE=langflow)
# Untuk deployment lokal gunakan: http://localhost:7860
LANGFLOW_BASE_URL=http://localhost:7860
LANGFLOW_API_KEY=your_langflow_api_key_here

# Flow ID: Pencocokan Keluarga (SalingJaga Family Matcher)
LANGFLOW_FAMILY_MATCH_FLOW_ID=f70b6854-1fed-475c-9f11-238d97242bc8

# Flow ID: Triase Laporan Bencana (Flow 1 AI Triage)
LANGFLOW_TRIAGE_FLOW_ID=0c029d7b-4036-4a66-8aa4-a364cd3ee528

# Flow ID: Chatbot Bencana Warga (SalingJaga Chatbot Bencana)
LANGFLOW_CHATBOT_FLOW_ID=2711834c-3cec-4a25-93df-524bc13593ee
